#!/bin/sh /etc/rc.common
# OpenWRT init script for authu. Drop into /etc/init.d/ and `chmod +x`.
#
# Setup:
#   cp authu /usr/sbin/authu                    # the binary
#   mkdir -p /etc/authu
#   cp config.example.toml /etc/authu/config.toml && vi /etc/authu/config.toml
#   cp authu /etc/init.d/authu && chmod +x /etc/init.d/authu
#   /etc/init.d/authu enable
#   /etc/init.d/authu start

USE_PROCD=1
START=95
STOP=01

PROG=/usr/sbin/authu
CONFIG=/etc/authu/config.toml

start_service() {
    procd_open_instance
    procd_set_param command "$PROG" -c "$CONFIG" login -k -D
    procd_set_param respawn 5 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
