# ---- menu / titles ----

msgid "srunc"
msgstr "srunc"

msgid "srunc — srun captive-portal auth"
msgstr "srunc — srun (深澜) 校园网认证"

msgid "Settings"
msgstr "设置"

msgid "Status"
msgstr "状态"

msgid "Actions"
msgstr "操作"

msgid "Log"
msgstr "日志"

# ---- top-level form blurb ----

msgid "Set username and password; the portal host and ac_id are auto-discovered from the captive redirect, so the override fields can stay blank. Pick a deployment profile below to use built-in defaults instead."
msgstr "填好用户名和密码即可使用；认证主机和 ac_id 会从校园网弹出页面自动识别，所以下面的覆盖字段可以留空。也可以选择一个预置部署，套用内置的默认值。"

# ---- form tabs ----

msgid "Basic"
msgstr "基本"

msgid "Advanced"
msgstr "高级"

msgid "Keepalive"
msgstr "保活"

# ---- basic tab ----

msgid "Enabled"
msgstr "启用"

msgid "Deployment"
msgstr "部署"

msgid "Pick your srun deployment to use its built-in defaults. Choose <em>Custom</em> to fall through to captive-portal auto-discovery."
msgstr "选择你所在的 srun 部署，套用其内置默认值。选择 <em>Custom</em> 则交由认证页面自动识别。"

msgid "Resolved"
msgstr "实际生效"

msgid "Portal host: auto-discovered from the captive redirect"
msgstr "认证主机：从校园网弹出页自动识别"

msgid "ac_id: auto-discovered from the captive redirect"
msgstr "ac_id：从校园网弹出页自动识别"

msgid "Portal host: <strong>%s</strong>"
msgstr "认证主机：<strong>%s</strong>"

msgid "Portal host: auto-discovered (this deployment is label-only)"
msgstr "认证主机：自动识别（该部署仅有名称，未内置主机）"

msgid "ac_id: <strong>auto-discovered</strong> per network segment"
msgstr "ac_id：<strong>按网段自动识别</strong>"

msgid "— Custom / auto —"
msgstr "— 自定义 / 自动 —"

msgid "Username"
msgstr "用户名"

msgid "Password"
msgstr "密码"

msgid "Show/hide password"
msgstr "显示/隐藏密码"

# ---- advanced tab ----

msgid "Portal host"
msgstr "认证主机"

msgid "Leave blank to use the host the selected <em>Deployment</em> profile carries, or to fall through to captive-portal auto-discovery if no profile is picked. Set a value here only to override both."
msgstr "留空时使用所选 <em>部署</em> 自带的主机；未选部署则交由校园网弹出页自动识别。仅当你想同时覆盖二者时才填值。"

msgid "blank = from profile / auto-discover"
msgstr "留空 = 取自部署 / 自动识别"

msgid "ac_id"
msgstr "ac_id"

msgid "Leave blank to auto-discover the segment-correct ac_id from the captive redirect at every login. Set a value here only if you know your network segment's ac_id and want to skip the probe. <strong>Deployment profiles deliberately do NOT pin ac_id</strong> — it varies per dorm / building / VLAN."
msgstr "留空时，每次登录都从校园网弹出页自动识别该网段对应的 ac_id。仅当你已知本网段 ac_id、想跳过探测时才填值。<strong>预置部署故意不固化 ac_id</strong>——它因宿舍 / 楼栋 / VLAN 而异。"

msgid "blank = auto-discover"
msgstr "留空 = 自动识别"

msgid "Discover from gateway"
msgstr "从网关探测"

msgid "Discover"
msgstr "探测"

msgid "Probe the default gateway for the captive-portal redirect and prefill <em>Portal host</em> + <em>ac_id</em> above."
msgstr "向默认网关探测一次校园网认证页，自动填入上面的 <em>认证主机</em> 和 <em>ac_id</em>。"

msgid "Probing…"
msgstr "探测中…"

msgid "Discovered host %s, ac_id %s"
msgstr "已识别：主机 %s，ac_id %s"

msgid "Discover failed: %s"
msgstr "探测失败：%s"

msgid "no captive redirect found"
msgstr "未发现校园网认证页"

msgid "Use http://"
msgstr "使用 http://"

msgid "Use plain <code>http://</code> instead of <code>https://</code> for portal requests. Leave off unless your portal cert is self-signed AND you trust the LAN you're on; otherwise authentication credentials transit unencrypted."
msgstr "使用 <code>http://</code> 明文请求认证接口，而非 <code>https://</code>。除非你的认证主机使用自签证书、并且你信任当前局域网，否则不要开启；否则用户名密码会明文传输。"

msgid "HTTP timeout (seconds)"
msgstr "HTTP 超时（秒）"

msgid "Log level"
msgstr "日志级别"

msgid "Verbosity of the background daemon. Higher levels show more in the <em>Log</em> tab."
msgstr "后台守护进程的日志详尽程度。级别越高，<em>日志</em> 标签里显示得越多。"

msgid "Error"
msgstr "错误"

msgid "Warning"
msgstr "警告"

msgid "Info"
msgstr "信息"

msgid "Debug"
msgstr "调试"

# ---- keepalive tab ----

msgid "Enable keepalive"
msgstr "启用保活"

msgid "Pass <code>-k</code> to srunc so it keeps the session alive."
msgstr "向 srunc 传入 <code>-k</code>，让它持续保持会话。"

msgid "In-campus keepalive probe"
msgstr "校内保活探测"

msgid "Probe an in-campus URL instead of the public internet (useful where public traffic is billed)."
msgstr "向校内 URL 而非公网发起探测（适用于公网流量计费的场景）。"

msgid "Probe interval (seconds)"
msgstr "探测间隔（秒）"

msgid "Consecutive failures before exit"
msgstr "连续失败次数后退出"

# ---- overview: status card ----

msgid "Online"
msgstr "在线"

msgid "Offline"
msgstr "离线"

msgid "keepalive"
msgstr "保活中"

msgid "Portal"
msgstr "认证主机"

msgid "auto-discovered"
msgstr "自动识别"

msgid "User"
msgstr "用户"

msgid "IP"
msgstr "IP"

msgid "IPv6"
msgstr "IPv6"

msgid "MAC"
msgstr "MAC"

msgid "Plan"
msgstr "套餐"

msgid "Devices"
msgstr "设备数"

msgid "Used"
msgstr "已用流量"

msgid "Time"
msgstr "已用时长"

msgid "Last keepalive"
msgstr "上次保活"

msgid "Session"
msgstr "会话"

msgid "Online devices"
msgstr "在线设备"

# ---- overview: setup banner ----

msgid "Setup required."
msgstr "需要先完成设置。"

msgid "No username configured yet. "
msgstr "尚未配置用户名。"

msgid "Open Settings"
msgstr "前往设置"

msgid "to enter your portal credentials."
msgstr "填入校园网账号。"

# ---- overview: actions / notifications ----

msgid "Login now"
msgstr "立即登录"

msgid "Logout"
msgstr "退出"

msgid "Restart service"
msgstr "重启服务"

msgid "Working…"
msgstr "处理中…"

msgid "login"
msgstr "登录"

msgid "logout"
msgstr "退出"

msgid "restart"
msgstr "重启"

msgid "%s: %s"
msgstr "%s：%s"

msgid "failed"
msgstr "失败"

msgid "dispatch failed"
msgstr "下发失败"

msgid "Logged in as %s."
msgstr "已登录：%s"

msgid "Login succeeded."
msgstr "登录成功"

msgid "Login dispatched but the daemon is still offline after %d s. Check the Log tab for the portal's error code."
msgstr "已下发登录命令，但 %d 秒后守护进程仍未上线。请到日志标签查看 portal 返回的错误码。"

msgid "Logged out."
msgstr "已退出"

msgid "Logout dispatched but the session is still online after %d s."
msgstr "已下发退出命令，但 %d 秒后会话仍在线。"

msgid "Service restarted."
msgstr "服务已重启"

msgid "Service restarted; logged in as %s."
msgstr "服务已重启；已登录：%s"

msgid "Service restarted but the daemon is still offline after %d s."
msgstr "服务已重启，但 %d 秒后守护进程仍未上线。"

# ---- overview: copy buttons ----

msgid "Copy \"%s\""
msgstr "复制 \"%s\""

msgid "Copied: %s"
msgstr "已复制：%s"

msgid "Could not copy to clipboard."
msgstr "复制到剪贴板失败。"

# ---- timestamps ----

msgid "just now"
msgstr "刚刚"

msgid "ago"
msgstr "前"

# ---- log view ----

msgid "Refresh"
msgstr "刷新"

msgid "Pause auto-refresh"
msgstr "暂停自动刷新"

msgid "Copy"
msgstr "复制"

msgid "Copy log to clipboard"
msgstr "复制日志到剪贴板"

msgid "Log copied to clipboard."
msgstr "日志已复制到剪贴板。"

msgid "Could not copy log: %s"
msgstr "复制日志失败：%s"

msgid "unknown error"
msgstr "未知错误"

msgid "No log output yet."
msgstr "暂无日志输出。"

msgid "Recent srunc messages from the system log. Adjust how much is shown with <em>Log level</em> under Settings → Advanced."
msgstr "来自系统日志的近期 srunc 消息。可在 <em>设置 → 高级</em> 中通过 <em>日志级别</em> 调节详尽程度。"

msgid "Service running"
msgstr "服务运行中"

msgid "Service stopped"
msgstr "服务已停止"
